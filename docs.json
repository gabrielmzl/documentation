{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Pronttus | Documentação API",
  "colors": {
    "primary": "#284BCE",
    "light": "#d69000",
    "dark": "#d69000"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentação",
        "groups": [
          {
            "group": "Introdução",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Autenticação",
            "pages": [
              "authentication"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/introducao",
              "webhooks/tipos-webhooks"
            ]
          }
        ]
      },
      {
        "tab": "Referência da API",
        "groups": [
          {
            "group": "Autenticação",
            "pages": [
              "api-reference/autenticacao"
            ]
          },
          {
            "group": "Recebimentos",
            "pages": [
              "api-reference/criar-cobranca"
            ]
          },
          {
            "group": "Transferências",
            "pages": [
              "api-reference/criar-transferencia"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.pronttus.com.br",
          "icon": "gauge"
        },
        {
          "anchor": "Status da API",
          "href": "https://status.pronttus.com.br",
          "icon": "chart-line"
        },
        {
          "anchor": "Suporte",
          "href": "mailto:dev@pronttus.com.br",
          "icon": "headset"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "mailto:dev@pronttus.com.br"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/pronttus",
      "linkedin": "https://linkedin.com/company/pronttus"
    }
  }
}